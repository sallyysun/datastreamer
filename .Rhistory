library(hermiter)
library(jsonlite)
library(httpuv)
library(later)
source(file.path(dirname(sys.frame(1)$ofile), "ring_buffer.R"))
source(file.path(dirname(sys.frame(1)$ofile), "online_npcorr.R"))
args <- commandArgs(trailingOnly = TRUE)
flag <- function(name, default) {
idx <- match(name, args)
if (is.na(idx)) return(default)
if (is.logical(default)) return(TRUE)
val <- args[idx + 1]
if (is.numeric(default)) return(as.numeric(val))
val
}
N              <- as.integer(flag("--N", 2000))
RHO            <- flag("--rho", 0.6)
NONSTATIONARY  <- flag("--nonstationary", FALSE)
WINDOW         <- as.integer(flag("--window", 100))
WARMUP         <- 50L
CHART_PORT     <- as.integer(flag("--port", 9090))
DELAY_MS       <- flag("--delay", 10)
REPORT_EVERY   <- as.integer(flag("--report", 10))
PROJ_ROOT <- normalizePath(file.path(dirname(sys.frame(1)$ofile), ".."))
CSV_DIR   <- file.path(PROJ_ROOT, "simulated-data")
dir.create(CSV_DIR, showWarnings = FALSE, recursive = TRUE)
timestamp_str <- format(Sys.time(), "%Y%m%d_%H%M%S")
mode_str      <- if (NONSTATIONARY) "nonstationary" else "stationary"
CSV_PATH      <- file.path(CSV_DIR, sprintf("sim_%s_%s.csv", mode_str, timestamp_str))
grade_correlation <- function(rho) (6 / pi) * asin(rho / 2)
rho_at <- if (NONSTATIONARY) {
regimes <- c(0.7, -0.3, 0.9, -0.6, 0.2)
regime_len <- N %/% length(regimes)
function(i) regimes[min(((i - 1) %/% regime_len) + 1, length(regimes))]
} else {
function(i) RHO
}
gen_one <- function(rho) {
z1 <- rnorm(1)
z2 <- rnorm(1)
x  <- z1
y  <- rho * z1 + sqrt(1 - rho^2) * z2
c(x, y)
}
herm_stat    <- hermite_estimator(N = 30, standardize = TRUE, est_type = "bivariate")
herm_ew      <- hermite_estimator(N = 30, standardize = TRUE, est_type = "bivariate",
exp_weight_lambda = 0.01)
est_spear    <- NULL
est_sp_win   <- NULL
warmup_vals  <- matrix(NA_real_, nrow = WARMUP, ncol = 2)
buf          <- new_ring_buffer(max(WINDOW, 512L), ncol = 2L)
init_cutpoint_estimators <- function() {
cpx <- quantile(warmup_vals[, 1], probs = seq(0.1, 0.9, by = 0.1))
cpy <- quantile(warmup_vals[, 2], probs = seq(0.1, 0.9, by = 0.1))
est_spear  <<- new_online_npcorr(cpx, cpy, "spearmanr")
est_sp_win <<- new_online_npcorr(cpx, cpy, "spearmanr")
for (k in seq_len(WARMUP)) {
npcorr_update(est_spear,  warmup_vals[k, 1], warmup_vals[k, 2])
npcorr_update(est_sp_win, warmup_vals[k, 1], warmup_vals[k, 2])
}
}
csv_con <- file(CSV_PATH, open = "wt")
writeLines(paste(
"obs", "rho", "grade_corr",
"npcorr_spearman", "npcorr_spearman_win",
"hermiter_spearman", "hermiter_spearman_ew",
sep = ","
), csv_con)
DASH_LINES <- 11L
dashboard <- function(i, rho) {
gc <- grade_correlation(rho)
ns  <- if (!is.null(est_spear))  npcorr_value(est_spear)  else NA
nsw <- if (!is.null(est_sp_win)) npcorr_value(est_sp_win) else NA
hs  <- tryCatch(spearmans(herm_stat), error = function(e) NA)
hse <- tryCatch(spearmans(herm_ew),   error = function(e) NA)
if (i > REPORT_EVERY) cat(sprintf("\033[%dA", DASH_LINES))
fmt <- "  %-28s %10.6f\n"
cat(sprintf("\033[2K── Observation %d / %d  (rho = %.2f) ─────────────\n", i, N, rho))
cat(sprintf("\033[2K  %-28s %10s\n", "", "Spearman"))
cat(sprintf("\033[2K  %-28s %10s\n", "", "────────"))
cat(sprintf("\033[2K"))
cat(sprintf(fmt, "grade corr Cor(F(X),G(Y))",  gc))
cat(sprintf("\033[2K"))
cat(sprintf(fmt, "npcorr (stationary)",         ns))
cat(sprintf("\033[2K"))
cat(sprintf(fmt, sprintf("npcorr (window=%d)", WINDOW), nsw))
cat(sprintf("\033[2K"))
cat(sprintf(fmt, "hermiter (stationary)",       hs))
cat(sprintf("\033[2K"))
cat(sprintf(fmt, "hermiter (exp-weighted)",     hse))
cat(sprintf("\033[2K  buffer: %d / %d   |   csv: %s\n",
ring_size(buf), buf$capacity, basename(CSV_PATH)))
cat(sprintf("\033[2K──────────────────────────────────────────────\n"))
}
ws_clients <- list()
chart_html <- '<!DOCTYPE html>
<html><head>
<meta charset="utf-8">
<title>Spearman Convergence</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<style>
body { margin:0; background:#111; color:#ccc; font-family:monospace; }
#wrap { width:95%; max-width:1200px; margin:20px auto; }
h2 { text-align:center; font-weight:normal; }
canvas { width:100% !important; }
#stats { display:flex; justify-content:space-around; margin:15px 0; font-size:14px; }
.stat-box { text-align:center; }
.stat-val { font-size:22px; font-weight:bold; }
.grade { color:#ff6384; }
.npc   { color:#36a2eb; }
.herm  { color:#4bc0c0; }
</style>
</head><body>
<div id="wrap">
<h2>Online Spearman vs Grade Correlation Cor(F(X), G(Y))</h2>
<div id="stats">
<div class="stat-box"><div class="stat-val grade" id="v-grade">--</div>Grade Corr</div>
<div class="stat-box"><div class="stat-val npc" id="v-npc">--</div>npcorr</div>
<div class="stat-box"><div class="stat-val herm" id="v-herm">--</div>hermiter</div>
<div class="stat-box"><div>Obs</div><div class="stat-val" id="v-obs">0</div></div>
</div>
<canvas id="chart" height="350"></canvas>
</div>
<script>
const MAX_PTS = 800;
const ctx = document.getElementById("chart").getContext("2d");
const chart = new Chart(ctx, {
type: "line",
data: {
labels: [],
datasets: [
{ label:"grade corr Cor(F(X),G(Y))", borderColor:"#ff6384", data:[], pointRadius:0, borderWidth:2 },
{ label:"npcorr (stationary)", borderColor:"#36a2eb", data:[], pointRadius:0, borderWidth:1.5 },
{ label:"npcorr (windowed)", borderColor:"#36a2eb", data:[], pointRadius:0, borderWidth:1.5, borderDash:[5,3] },
{ label:"hermiter (stationary)", borderColor:"#4bc0c0", data:[], pointRadius:0, borderWidth:1.5 },
{ label:"hermiter (exp-weighted)", borderColor:"#4bc0c0", data:[], pointRadius:0, borderWidth:1.5, borderDash:[5,3] },
]
},
options: {
animation: false,
responsive: true,
scales: {
x: { display:true, ticks:{ color:"#666", maxTicksLimit:10 }, grid:{ color:"#222" } },
y: { display:true, ticks:{ color:"#666" }, grid:{ color:"#222" },
suggestedMin:-1, suggestedMax:1 }
},
plugins: { legend:{ labels:{ color:"#999", font:{size:11} } } }
}
});
const ws = new WebSocket("ws://" + location.host);
ws.onmessage = function(e) {
const d = JSON.parse(e.data);
chart.data.labels.push(d.obs);
chart.data.datasets[0].data.push(d.grade_corr);
chart.data.datasets[1].data.push(d.npcorr_spearman);
chart.data.datasets[2].data.push(d.npcorr_spearman_win);
chart.data.datasets[3].data.push(d.hermiter_spearman);
chart.data.datasets[4].data.push(d.hermiter_spearman_ew);
if (chart.data.labels.length > MAX_PTS) {
chart.data.labels.shift();
chart.data.datasets.forEach(ds => ds.data.shift());
}
chart.update();
document.getElementById("v-obs").textContent = d.obs;
document.getElementById("v-grade").textContent =
(d.grade_corr !== null ? d.grade_corr.toFixed(4) : "--");
document.getElementById("v-npc").textContent =
(d.npcorr_spearman !== null ? d.npcorr_spearman.toFixed(4) : "--");
document.getElementById("v-herm").textContent =
(d.hermiter_spearman !== null ? d.hermiter_spearman.toFixed(4) : "--");
};
</script>
</body></html>'
start_chart_server <- function(port) {
httpuv::startServer("0.0.0.0", port, list(
call = function(req) {
list(status = 200L,
headers = list("Content-Type" = "text/html"),
body = chart_html)
},
onWSOpen = function(ws) {
id <- length(ws_clients) + 1L
ws_clients[[id]] <<- ws
ws$onClose(function() { ws_clients[[id]] <<- NULL })
}
))
}
broadcast <- function(msg) {
for (ws in ws_clients) {
if (!is.null(ws)) tryCatch(ws$send(msg), error = function(e) NULL)
}
}
set.seed(as.integer(Sys.time()))
cat(sprintf("Mode: %s  |  N: %d  |  rho: %.2f  |  window: %d\n",
mode_str, N, RHO, WINDOW))
cat(sprintf("CSV: %s\n", CSV_PATH))
cat(sprintf("Starting chart server on http://localhost:%d ...\n", CHART_PORT))
srv <- start_chart_server(CHART_PORT)
on.exit({ srv$stop(); close(csv_con) }, add = TRUE)
cat(sprintf("Open http://localhost:%d in a browser, then press Enter to start.\n", CHART_PORT))
invisible(readline())
rho_now <- rho_at(i)
obs     <- gen_one(rho_now)
xi      <- obs[1]
yi      <- obs[2]
# ── ring buffer ──
ring_push(buf, c(xi, yi))
flush(csv_con)
cat(sprintf("\n\nDone. %d observations written to %s\n", N, CSV_PATH))
# Simulation harness: generates correlated data one observation at a time,
# feeds to all Spearman estimators, and outputs three ways simultaneously:
#
#   1. Terminal dashboard  — ANSI-overwritten table of current estimates
#   2. Live browser chart  — httpuv WS → Chart.js (http://localhost:9090)
#   3. CSV log             — every observation's estimates in simulated-data/
#
# The theoretical target is the grade correlation: Cor(F(X), G(Y)),
# the Pearson product-moment correlation of the marginal CDFs.
# For bivariate normal this equals (6/pi) * arcsin(rho/2).
#
# Usage:
#   Rscript R/simulate.R                        # stationary, rho=0.6, N=2000
#   Rscript R/simulate.R --nonstationary        # regime-switching
#   Rscript R/simulate.R --N 5000 --rho 0.8     # custom
#
# No C++ server needed.
library(hermiter)
library(jsonlite)
library(httpuv)
library(later)
source(file.path(dirname(sys.frame(1)$ofile), "ring_buffer.R"))
?sys.frame
# Simulation harness: generates correlated data one observation at a time,
# feeds to all Spearman estimators, and outputs three ways simultaneously:
#
#   1. Terminal dashboard  — ANSI-overwritten table of current estimates
#   2. Live browser chart  — httpuv WS → Chart.js (http://localhost:9090)
#   3. CSV log             — every observation's estimates in simulated-data/
#
# The theoretical target is the grade correlation: Cor(F(X), G(Y)),
# the Pearson product-moment correlation of the marginal CDFs.
# For bivariate normal this equals (6/pi) * arcsin(rho/2).
#
# Usage:
#   Rscript R/simulate.R                        # stationary, rho=0.6, N=2000
#   Rscript R/simulate.R --nonstationary        # regime-switching
#   Rscript R/simulate.R --N 5000 --rho 0.8     # custom
#
# No C++ server needed.
library(hermiter)
library(jsonlite)
library(httpuv)
library(later)
# resolve script directory (Rscript, source(), or interactive)
SCRIPT_DIR <- local({
# 1. Rscript --file=
a <- commandArgs(trailingOnly = FALSE)
f <- grep("^--file=", a, value = TRUE)
if (length(f) > 0) return(normalizePath(dirname(sub("^--file=", "", f[1]))))
# 2. source() — walk the call stack for $ofile
for (i in seq_len(sys.nframe())) {
of <- tryCatch(sys.frame(i)$ofile, error = function(e) NULL)
if (!is.null(of)) return(normalizePath(dirname(of)))
}
# 3. interactive fallback
if (dir.exists(file.path(getwd(), "R"))) return(normalizePath(file.path(getwd(), "R")))
normalizePath(getwd())
})
source(file.path(SCRIPT_DIR, "ring_buffer.R"))
source(file.path(SCRIPT_DIR, "ring_buffer.R"))
