# Exact 95% CI
lower <- sqrt(S / qchisq(0.975, df = 2 * n))
upper <- sqrt(S / qchisq(0.025, df = 2 * n))
rain <- c(860.0, 1207.6, 995.2, 816.0, 994.0)
n <- length(rain)
