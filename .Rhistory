library(flexdashboard)
library(tidyverse)
library(gapminder)
library(shiny)
library(plotly)
library(RColorBrewer)
# Chunk 2
data("gapminder")
gapminder <- gapminder %>%
mutate(
country = as.character(country),
continent = as.character(continent)
)
valvars <- c("lifeExp", "pop", "gdpPercap")
valnames <- c("Life expectancy at birth", "Population", "GDP Per-capita in USD")
names(valvars) <- valnames
colvars <- c("continent", "country", "lifeExp", "pop", "gdpPercap")
colnames <- c("Continent", "Country", "Life expectancy at birth", "Population", "GDP Per-capita in USD")
names(colvars) <- colnames
countries <- sort(unique(gapminder$country))
## Helper function ---
fmt <- function(x , v) {
switch(v,
lifeExp = sprintf("%0.0f years", round(x)),
pop = sprintf("%1.1f %s",
x / 1000 ^ (log10(x) %/% 3),
c("", "thousand", "million", "billion")[log10(x) %/% 3 +1]),
gdpPercap = sprintf("%s USD", format(round(x), big.mark = ",")),
x
)
}
# Chunk 3
selectInput("xvar", "X-axis", choices = valnames,
selected = valnames[3], multiple = FALSE)
checkboxInput("xlog", "Log scale", value = TRUE)
selectInput("yvar", "Y-axis", choices = valnames,
selected = valnames[1], multiple = FALSE)
selectInput("sizevar", "Size", choice = valnames,
selected = valnames[2], multiple = FALSE)
selectInput("colvar", "Colour", choices = colnames,
selected = colnames[1], multiple = FALSE)
# Chunk 4
selected <- reactiveVal(c())
xvar    <- reactive(valvars[[input$xvar]])
yvar    <- reactive(valvars[[input$yvar]])
sizevar <- reactive(valvars[[input$sizevar]])
colvar  <- reactive(colvars[[input$colvar]])
colmap <- reactive({
vals <- sort(unique(gapminder[[colvar()]]))
n <- max(length(vals), 3)
pal <- colorRampPalette(brewer.pal(min(n, 8), "Set2"))(length(vals))
setNames(pal, vals)
})
# Chunk 5
toplot <- reactive({
gapminder |>
mutate(
x    = .data[[xvar()]],
y    = .data[[yvar()]],
## Note: Plotly (like ggplot2) automatically maps size to area via
## square root, so raw population values are passed directly.
size = .data[[sizevar()]],
col  = .data[[colvar()]]
) |>
rowwise() |>
mutate(
text = paste(unique(c(
sprintf("%s (%0.0f)",   country,      year),
sprintf("%s: %s", input$xvar,    fmt(x,    xvar())),
sprintf("%s: %s", input$yvar,    fmt(y,    yvar())),
sprintf("%s: %s", input$sizevar, fmt(size, sizevar())),
sprintf("%s: %s", input$colvar,  fmt(col,  colvar()))
)), collapse = "\n")
) |>
ungroup()
})
# Chunk 6
renderPlotly({
plot_ly(toplot()) |>
add_trace(
type       = "scatter",
mode       = "markers",
x          = ~x,
y          = ~y,
size       = ~size,
color      = ~col,
colors     = colmap(),            # explicit palette shared with trend plot
frame      = ~year,
hoverinfo  = "text",
hovertext  = ~text,
customdata = ~country
) |>
layout(
xaxis = list(
title = input$xvar,
type  = if (input$xlog) "log" else "linear",
range = (if (input$xlog) log10 else identity)(range(gapminder[[xvar()]]))
),
yaxis = list(
title = input$yvar,
type  = if (input$ylog) "log" else "linear",
range = (if (input$ylog) log10 else identity)(range(gapminder[[yvar()]]))
),
legend    = list(title = list(text = input$colvar)),
clickmode = "select+event",
dragmode  = "select"
) |>
event_register("plotly_selected")
})
