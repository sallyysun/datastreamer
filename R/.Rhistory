msg_history[length(msg_history) + 1L] <<- msg
for (ws in ws_clients) {
if (!is.null(ws)) tryCatch(ws$send(msg), error = function(e) NULL)
}
}
# ── main loop ────────────────────────────────────────────────────────────
set.seed(as.integer(Sys.time()))
cat(sprintf("Mode: %s  |  N: %d  |  rho: %.2f  |  window: %d\n",
mode_str, N, RHO, WINDOW))
cat(sprintf("CSV:   %s\n", CSV_PATH))
srv <- tryCatch({
s <- start_chart_server(CHART_PORT)
cat(sprintf("Chart: http://localhost:%d\n", CHART_PORT))
s
}, error = function(e) {
cat(sprintf("Chart server unavailable (port %d in use), continuing without it.\n", CHART_PORT))
NULL
})
on.exit({ if (!is.null(srv)) srv$stop() }, add = TRUE)
cat("\n")
for (i in seq_len(N)) {
rho_now <- rho_at(i)
obs     <- gen_one(rho_now)
xi      <- obs[1]
yi      <- obs[2]
# ── ring buffer ──
ring_push(buf, c(xi, yi))
# ── hermiter ──
herm_stat <- update_sequential(herm_stat, c(xi, yi))
herm_ew   <- update_sequential(herm_ew,   c(xi, yi))
# ── npcorr: Spearman (after warmup) ──
if (i <= WARMUP) {
warmup_vals[i, ] <- c(xi, yi)
if (i == WARMUP) init_cutpoint_estimators()
} else {
npcorr_update(est_spear,  xi, yi)
npcorr_update(est_sp_win, xi, yi)
if (est_sp_win$n > WINDOW) {
old_w <- ring_get(buf, buf$head - WINDOW)
npcorr_remove(est_sp_win, old_w[1], old_w[2])
}
}
# ── collect estimates ──
gc  <- grade_correlation(rho_now)
ns  <- if (!is.null(est_spear))  npcorr_value(est_spear)  else NA
nsw <- if (!is.null(est_sp_win)) npcorr_value(est_sp_win) else NA
hs  <- tryCatch(spearmans(herm_stat), error = function(e) NA)
hse <- tryCatch(spearmans(herm_ew),   error = function(e) NA)
# ── CSV write ──
csv_append(i, rho_now, gc, ns, nsw, hs, hse)
# ── service httpuv (accept new WS connections before broadcast) ──
if (!is.null(srv)) httpuv::service(timeoutMs = 1)
# ── broadcast to chart ──
if (!is.null(srv)) {
msg <- toJSON(list(
obs = i, rho = rho_now, grade_corr = gc,
npcorr_spearman = ns, npcorr_spearman_win = nsw,
hermiter_spearman = hs, hermiter_spearman_ew = hse
), auto_unbox = TRUE, na = "null")
broadcast(msg)
}
# ── terminal dashboard ──
if (i %% REPORT_EVERY == 0) dashboard(i, rho_now)
# ── pace ──
if (DELAY_MS > 0) Sys.sleep(DELAY_MS / 1000)
}
# Simulation: online Spearman estimators vs batch Spearman vs grade correlation
#
# Generates correlated bivariate normal data one observation at a time and
# compares four estimators against the theoretical grade correlation
# Cor(F(X), G(Y)) = (6/pi) * arcsin(rho/2).
#
# Outputs:
#   1. Live plot in RStudio Plots pane (updates every REPORT_EVERY obs)
#   2. Console table of current estimates
#   3. CSV + PDF in simulated-data/
#
# Usage (source in RStudio or run via Rscript):
#   source("R/simulate.R")
#   Rscript R/simulate.R --N 2000 --rho 0.8
#   Rscript R/simulate.R --nonstationary
library(hermiter)
# resolve script directory (Rscript, source(), or interactive)
SCRIPT_DIR <- local({
a <- commandArgs(trailingOnly = FALSE)
f <- grep("^--file=", a, value = TRUE)
if (length(f) > 0) return(normalizePath(dirname(sub("^--file=", "", f[1]))))
for (i in seq_len(sys.nframe())) {
of <- tryCatch(sys.frame(i)$ofile, error = function(e) NULL)
if (!is.null(of)) return(normalizePath(dirname(of)))
}
if (dir.exists(file.path(getwd(), "R"))) return(normalizePath(file.path(getwd(), "R")))
normalizePath(getwd())
})
source(file.path(SCRIPT_DIR, "online_npcorr.R"))
# ── parse args ───────────────────────────────────────────────────────────
args <- commandArgs(trailingOnly = TRUE)
flag <- function(name, default) {
idx <- match(name, args)
if (is.na(idx)) return(default)
if (is.logical(default)) return(TRUE)
val <- args[idx + 1]
if (is.numeric(default)) return(as.numeric(val))
val
}
N              <- as.integer(flag("--N", 2000))
RHO            <- flag("--rho", 0.6)
NONSTATIONARY  <- flag("--nonstationary", FALSE)
WARMUP         <- 50L
DELAY_MS       <- flag("--delay", 10)
REPORT_EVERY   <- as.integer(flag("--report", 20))
PROJ_ROOT <- normalizePath(file.path(SCRIPT_DIR, ".."))
CSV_DIR   <- file.path(PROJ_ROOT, "simulated-data")
dir.create(CSV_DIR, showWarnings = FALSE, recursive = TRUE)
timestamp_str <- format(Sys.time(), "%Y%m%d_%H%M%S")
mode_str      <- if (NONSTATIONARY) "nonstationary" else "stationary"
CSV_PATH      <- file.path(CSV_DIR, sprintf("sim_%s_%s.csv", mode_str, timestamp_str))
# ── grade correlation: Cor(F(X), G(Y)) ──────────────────────────────────
grade_correlation <- function(rho) (6 / pi) * asin(rho / 2)
# ── regime schedule (non-stationary) ─────────────────────────────────────
rho_at <- if (NONSTATIONARY) {
regimes <- c(0.7, -0.3, 0.9, -0.6, 0.2)
regime_len <- N %/% length(regimes)
function(i) regimes[min(((i - 1) %/% regime_len) + 1, length(regimes))]
} else {
function(i) RHO
}
# ── data generator ──────────────────────────────────────────────────────
gen_one <- function(rho) {
z1 <- rnorm(1)
z2 <- rnorm(1)
c(z1, rho * z1 + sqrt(1 - rho^2) * z2)
}
# ── estimators ──────────────────────────────────────────────────────────
herm_stat <- hermite_estimator(N = 30, standardize = TRUE, est_type = "bivariate")
herm_ew   <- hermite_estimator(N = 30, standardize = TRUE, est_type = "bivariate",
exp_weight_lambda = 0.01)
est_spear <- NULL
warmup_vals <- matrix(NA_real_, nrow = WARMUP, ncol = 2)
init_cutpoint_estimators <- function() {
cpx <- quantile(warmup_vals[, 1], probs = seq(0.1, 0.9, by = 0.1))
cpy <- quantile(warmup_vals[, 2], probs = seq(0.1, 0.9, by = 0.1))
est_spear <<- new_online_npcorr(cpx, cpy, "spearmanr")
for (k in seq_len(WARMUP)) {
npcorr_update(est_spear, warmup_vals[k, 1], warmup_vals[k, 2])
}
}
# ── storage vectors (for batch Spearman + plotting) ─────────────────────
all_x  <- numeric(N)
all_y  <- numeric(N)
v_gc   <- numeric(N)
v_ns   <- rep(NA_real_, N)
v_hs   <- rep(NA_real_, N)
v_hse  <- rep(NA_real_, N)
v_batch <- rep(NA_real_, N)
# ── CSV setup ────────────────────────────────────────────────────────────
cat(paste("obs", "rho", "grade_corr", "batch_spearman",
"npcorr_spearman", "hermiter_spearman", "hermiter_spearman_ew",
sep = ","),
"\n", sep = "", file = CSV_PATH)
csv_append <- function(...) {
cat(paste(..., sep = ","), "\n", sep = "", file = CSV_PATH, append = TRUE)
}
# ── console output ──────────────────────────────────────────────────────
chart_title <- if (NONSTATIONARY) {
"Non-Stationary: Tracking Regime-Switching Grade Correlation"
} else {
sprintf("Stationary: Convergence to Grade Correlation (rho = %.2f)", RHO)
}
print_status <- function(i, rho) {
na_fmt <- function(x) if (is.na(x)) sprintf("%10s", "NA") else sprintf("%10.6f", x)
cat(sprintf("── Observation %d / %d  (rho = %.2f) ──\n", i, N, rho))
cat(sprintf("  %-28s %s\n", "grade corr Cor(F(X),G(Y))", na_fmt(v_gc[i])))
cat(sprintf("  %-28s %s\n", "batch Spearman",             na_fmt(v_batch[i])))
cat(sprintf("  %-28s %s\n", "npcorr (online)",            na_fmt(v_ns[i])))
cat(sprintf("  %-28s %s\n", "hermiter (stationary)",      na_fmt(v_hs[i])))
cat(sprintf("  %-28s %s\n", "hermiter (exp-weighted)",    na_fmt(v_hse[i])))
cat(sprintf("  csv: %s\n", basename(CSV_PATH)))
}
# ── live plot helper ────────────────────────────────────────────────────
draw_plot <- function(up_to) {
idx <- 1:up_to
ylim <- range(c(v_gc[idx], v_batch[idx], v_ns[idx], v_hs[idx]), na.rm = TRUE)
ylim <- c(max(ylim[1], -1), min(ylim[2], 1))
plot(idx, v_gc[idx], type = "l", col = "#E41A1C", lwd = 2.5,
xlim = c(1, N), ylim = ylim,
xlab = "Observation", ylab = "Spearman",
main = chart_title)
lines(idx, v_batch[idx], col = "#984EA3", lwd = 2, lty = 2)
lines(idx, v_ns[idx],    col = "#377EB8", lwd = 1.5)
lines(idx, v_hs[idx],    col = "#4DAF4A", lwd = 1.5)
legend("bottomright", cex = 0.75, bty = "n",
legend = c("grade corr", "batch Spearman",
"npcorr (online)", "hermiter (online)"),
col = c("#E41A1C", "#984EA3", "#377EB8", "#4DAF4A"),
lwd = c(2.5, 2, 1.5, 1.5), lty = c(1, 2, 1, 1))
}
# ── main loop ────────────────────────────────────────────────────────────
set.seed(as.integer(Sys.time()))
cat(sprintf("Mode: %s  |  N: %d  |  rho: %.2f\n", mode_str, N, RHO))
cat(sprintf("CSV:  %s\n\n", CSV_PATH))
for (i in seq_len(N)) {
rho_now <- rho_at(i)
obs     <- gen_one(rho_now)
xi      <- obs[1]
yi      <- obs[2]
all_x[i] <- xi
all_y[i] <- yi
# ── hermiter ──
herm_stat <- update_sequential(herm_stat, c(xi, yi))
herm_ew   <- update_sequential(herm_ew,   c(xi, yi))
# ── npcorr (after warmup) ──
if (i <= WARMUP) {
warmup_vals[i, ] <- c(xi, yi)
if (i == WARMUP) init_cutpoint_estimators()
} else {
npcorr_update(est_spear, xi, yi)
}
# ── collect estimates ──
v_gc[i]    <- grade_correlation(rho_now)
v_ns[i]    <- if (!is.null(est_spear)) npcorr_value(est_spear) else NA
v_hs[i]    <- tryCatch(spearmans(herm_stat), error = function(e) NA)
v_hse[i]   <- tryCatch(spearmans(herm_ew),   error = function(e) NA)
v_batch[i] <- if (i >= 3) cor(all_x[1:i], all_y[1:i], method = "spearman") else NA
# ── CSV ──
csv_append(i, rho_now, v_gc[i], v_batch[i], v_ns[i], v_hs[i], v_hse[i])
# ── live plot + console (every REPORT_EVERY obs) ──
if (i %% REPORT_EVERY == 0) {
draw_plot(i)
print_status(i, rho_now)
}
if (DELAY_MS > 0) Sys.sleep(DELAY_MS / 1000)
}
# ── final plot + console ──
draw_plot(N)
print_status(N, rho_at(N))
cat(sprintf("\nDone. %d observations written to %s\n", N, CSV_PATH))
# ── save PDF ────────────────────────────────────────────────────────────
pdf_path <- sub("\\.csv$", ".pdf", CSV_PATH)
pdf(pdf_path, width = 10, height = 6)
draw_plot(N)
dev.off()
cat(sprintf("Plot saved to %s\n", pdf_path))
rstudioapi::jobRunScript("R/simulate.R")
setwd("~/_Github/datastreamer/R")
setwd("~/_Github/datastreamer/R")
rstudioapi::jobRunScript("R/simulate.R")
source("R/simulate.R")
source("simulate.R")
rstudioapi::jobRunScript("simulate.R")
N <- 1000L
# ── generate correlated data ─────────────────────────────────────────────
rho <- 0.6
z1  <- rnorm(N)
z2  <- rnorm(N)
x   <- z1
y   <- rho * z1 + sqrt(1 - rho^2) * z2
grade_corr <- (6 / pi) * asin(rho / 2)
cat(sprintf("Generated %d observations with rho = %.2f\n", N, rho))
cat(sprintf("Grade correlation Cor(F(X),G(Y)) = %.8f\n\n", grade_corr))
at("── Test 1: hermiter Spearman (stationary) ──\n")
cat("── Test 1: hermiter Spearman (stationary) ──\n")
est <- hermite_estimator(N = 30, standardize = TRUE, est_type = "bivariate")
for (i in seq_len(N)) {
est <- update_sequential(est, c(x[i], y[i]))
}
herm_sp <- spearmans(est)
batch_sp <- cor(x, y, method = "spearman")
cat(sprintf("  hermiter:    %.8f\n", herm_sp))
cat(sprintf("  batch:       %.8f\n", batch_sp))
cat(sprintf("  grade corr:  %.8f\n", grade_corr))
cat(sprintf("  diff (vs batch):  %.4e\n\n", abs(herm_sp - batch_sp)))
library(hermiter)
# resolve script directory
SCRIPT_DIR <- local({
a <- commandArgs(trailingOnly = FALSE)
f <- grep("^--file=", a, value = TRUE)
if (length(f) > 0) return(normalizePath(dirname(sub("^--file=", "", f[1]))))
for (i in seq_len(sys.nframe())) {
of <- tryCatch(sys.frame(i)$ofile, error = function(e) NULL)
if (!is.null(of)) return(normalizePath(dirname(of)))
}
if (dir.exists(file.path(getwd(), "R"))) return(normalizePath(file.path(getwd(), "R")))
normalizePath(getwd())
})
source(file.path(SCRIPT_DIR, "online_npcorr.R"))
PROJ_ROOT <- normalizePath(file.path(SCRIPT_DIR, ".."))
grade_correlation <- function(rho) (6 / pi) * asin(rho / 2)
gen_one <- function(rho) {
z1 <- rnorm(1)
c(z1, rho * z1 + sqrt(1 - rho^2) * rnorm(1))
}
log_msg <- function(...) cat(..., file = stderr())
run_stationary <- function(N = 2000, rho = 0.6, warmup = 50L,
report_every = 20L, delay_ms = 10,
seed = as.integer(Sys.time())) {
set.seed(seed)
title <- sprintf("Stationary: Convergence to Grade Correlation (rho = %.2f)", rho)
gc_val <- grade_correlation(rho)
# ── output paths ──
csv_dir <- file.path(PROJ_ROOT, "simulated-data")
dir.create(csv_dir, showWarnings = FALSE, recursive = TRUE)
ts   <- format(Sys.time(), "%Y%m%d_%H%M%S")
csv  <- file.path(csv_dir, sprintf("sim_stationary_%s.csv", ts))
cat(paste("obs", "rho", "grade_corr", "batch_spearman",
"npcorr_spearman", "hermiter_spearman",
sep = ","),
"\n", sep = "", file = csv)
# ── estimators ──
herm <- hermite_estimator(N = 30, standardize = TRUE, est_type = "bivariate")
npc  <- NULL
warmup_vals <- matrix(NA_real_, nrow = warmup, ncol = 2)
# ── storage ──
all_x   <- numeric(N)
all_y   <- numeric(N)
v_gc    <- numeric(N)
v_batch <- rep(NA_real_, N)
v_npc   <- rep(NA_real_, N)
v_herm  <- rep(NA_real_, N)
# ── plot ──
draw <- function(up_to) {
idx  <- 1:up_to
ylim <- range(c(v_gc[idx], v_batch[idx], v_npc[idx], v_herm[idx]), na.rm = TRUE)
ylim <- c(max(ylim[1], -1), min(ylim[2], 1))
plot(idx, v_gc[idx], type = "l", col = "#E41A1C", lwd = 2.5,
xlim = c(1, N), ylim = ylim,
xlab = "Observation", ylab = "Spearman", main = title)
lines(idx, v_batch[idx], col = "#984EA3", lwd = 2, lty = 2)
lines(idx, v_npc[idx],   col = "#377EB8", lwd = 1.5)
lines(idx, v_herm[idx],  col = "#4DAF4A", lwd = 1.5)
legend("bottomright", cex = 0.75, bty = "n",
legend = c("grade corr", "batch Spearman",
"npcorr (online)", "hermiter (online)"),
col = c("#E41A1C", "#984EA3", "#377EB8", "#4DAF4A"),
lwd = c(2.5, 2, 1.5, 1.5), lty = c(1, 2, 1, 1))
}
# ── status ──
status <- function(i) {
na_fmt <- function(x) if (is.na(x)) sprintf("%10s", "NA") else sprintf("%10.6f", x)
log_msg(sprintf("── Observation %d / %d  (rho = %.2f) ──\n", i, N, rho))
log_msg(sprintf("  %-28s %s\n", "grade corr Cor(F(X),G(Y))", na_fmt(v_gc[i])))
log_msg(sprintf("  %-28s %s\n", "batch Spearman",             na_fmt(v_batch[i])))
log_msg(sprintf("  %-28s %s\n", "npcorr (online)",            na_fmt(v_npc[i])))
log_msg(sprintf("  %-28s %s\n", "hermiter (online)",          na_fmt(v_herm[i])))
log_msg(sprintf("  csv: %s\n", basename(csv)))
}
log_msg(sprintf("Stationary  |  N: %d  |  rho: %.2f\n", N, rho))
log_msg(sprintf("CSV: %s\n\n", csv))
# ── loop ──
for (i in seq_len(N)) {
obs <- gen_one(rho)
all_x[i] <- obs[1]
all_y[i] <- obs[2]
herm <- update_sequential(herm, obs)
if (i <= warmup) {
warmup_vals[i, ] <- obs
if (i == warmup) {
cpx <- quantile(warmup_vals[, 1], probs = seq(0.1, 0.9, by = 0.1))
cpy <- quantile(warmup_vals[, 2], probs = seq(0.1, 0.9, by = 0.1))
npc <- new_online_npcorr(cpx, cpy, "spearmanr")
for (k in seq_len(warmup)) npcorr_update(npc, warmup_vals[k, 1], warmup_vals[k, 2])
}
} else {
npcorr_update(npc, obs[1], obs[2])
}
v_gc[i]    <- gc_val
v_npc[i]   <- if (!is.null(npc)) npcorr_value(npc) else NA
v_herm[i]  <- tryCatch(spearmans(herm), error = function(e) NA)
v_batch[i] <- if (i >= 3) cor(all_x[1:i], all_y[1:i], method = "spearman") else NA
cat(paste(i, rho, v_gc[i], v_batch[i], v_npc[i], v_herm[i], sep = ","),
"\n", sep = "", file = csv, append = TRUE)
if (i %% report_every == 0) { draw(i); status(i) }
if (delay_ms > 0) Sys.sleep(delay_ms / 1000)
}
draw(N); status(N)
log_msg(sprintf("\nDone. %d observations written to %s\n", N, csv))
pdf_path <- sub("\\.csv$", ".pdf", csv)
pdf(pdf_path, width = 10, height = 6); draw(N); dev.off()
log_msg(sprintf("Plot saved to %s\n", pdf_path))
invisible(list(csv = csv, pdf = pdf_path))
}
run_nonstationary <- function(N = 2000, regimes = c(0.7, -0.3, 0.9, -0.6, 0.2),
warmup = 50L, report_every = 20L, delay_ms = 10,
seed = as.integer(Sys.time())) {
set.seed(seed)
title <- "Non-Stationary: Tracking Regime-Switching Grade Correlation"
regime_len <- N %/% length(regimes)
rho_at <- function(i) regimes[min(((i - 1) %/% regime_len) + 1, length(regimes))]
# ── output paths ──
csv_dir <- file.path(PROJ_ROOT, "simulated-data")
dir.create(csv_dir, showWarnings = FALSE, recursive = TRUE)
ts   <- format(Sys.time(), "%Y%m%d_%H%M%S")
csv  <- file.path(csv_dir, sprintf("sim_nonstationary_%s.csv", ts))
cat(paste("obs", "rho", "grade_corr", "batch_spearman",
"npcorr_spearman", "hermiter_spearman", "hermiter_spearman_ew",
sep = ","),
"\n", sep = "", file = csv)
# ── estimators ──
herm_stat <- hermite_estimator(N = 30, standardize = TRUE, est_type = "bivariate")
herm_ew   <- hermite_estimator(N = 30, standardize = TRUE, est_type = "bivariate",
exp_weight_lambda = 0.01)
npc <- NULL
warmup_vals <- matrix(NA_real_, nrow = warmup, ncol = 2)
# ── storage ──
all_x   <- numeric(N)
all_y   <- numeric(N)
v_gc    <- numeric(N)
v_batch <- rep(NA_real_, N)
v_npc   <- rep(NA_real_, N)
v_herm  <- rep(NA_real_, N)
v_herm_ew <- rep(NA_real_, N)
# ── plot ──
draw <- function(up_to) {
idx  <- 1:up_to
ylim <- range(c(v_gc[idx], v_npc[idx], v_herm_ew[idx]), na.rm = TRUE)
ylim <- c(max(ylim[1], -1), min(ylim[2], 1))
plot(idx, v_gc[idx], type = "l", col = "#E41A1C", lwd = 2.5,
xlim = c(1, N), ylim = ylim,
xlab = "Observation", ylab = "Spearman", main = title)
lines(idx, v_batch[idx],   col = "#984EA3", lwd = 2, lty = 2)
lines(idx, v_npc[idx],     col = "#377EB8", lwd = 1.5)
lines(idx, v_herm_ew[idx], col = "#4DAF4A", lwd = 1.5)
lines(idx, v_herm[idx],    col = "#4DAF4A", lwd = 1, lty = 2)
legend("bottomright", cex = 0.75, bty = "n",
legend = c("grade corr", "batch Spearman",
"npcorr (online)", "hermiter (exp-wt)", "hermiter (stat)"),
col = c("#E41A1C", "#984EA3", "#377EB8", "#4DAF4A", "#4DAF4A"),
lwd = c(2.5, 2, 1.5, 1.5, 1), lty = c(1, 2, 1, 1, 2))
}
# ── status ──
status <- function(i) {
rho <- rho_at(i)
na_fmt <- function(x) if (is.na(x)) sprintf("%10s", "NA") else sprintf("%10.6f", x)
log_msg(sprintf("── Observation %d / %d  (rho = %.2f) ──\n", i, N, rho))
log_msg(sprintf("  %-28s %s\n", "grade corr Cor(F(X),G(Y))", na_fmt(v_gc[i])))
log_msg(sprintf("  %-28s %s\n", "batch Spearman",             na_fmt(v_batch[i])))
log_msg(sprintf("  %-28s %s\n", "npcorr (online)",            na_fmt(v_npc[i])))
log_msg(sprintf("  %-28s %s\n", "hermiter (stationary)",      na_fmt(v_herm[i])))
log_msg(sprintf("  %-28s %s\n", "hermiter (exp-weighted)",    na_fmt(v_herm_ew[i])))
log_msg(sprintf("  csv: %s\n", basename(csv)))
}
log_msg(sprintf("Non-stationary  |  N: %d  |  regimes: %s\n",
N, paste(regimes, collapse = ", ")))
log_msg(sprintf("CSV: %s\n\n", csv))
# ── loop ──
for (i in seq_len(N)) {
rho_now <- rho_at(i)
obs <- gen_one(rho_now)
all_x[i] <- obs[1]
all_y[i] <- obs[2]
herm_stat <- update_sequential(herm_stat, obs)
herm_ew   <- update_sequential(herm_ew,   obs)
if (i <= warmup) {
warmup_vals[i, ] <- obs
if (i == warmup) {
cpx <- quantile(warmup_vals[, 1], probs = seq(0.1, 0.9, by = 0.1))
cpy <- quantile(warmup_vals[, 2], probs = seq(0.1, 0.9, by = 0.1))
npc <- new_online_npcorr(cpx, cpy, "spearmanr")
for (k in seq_len(warmup)) npcorr_update(npc, warmup_vals[k, 1], warmup_vals[k, 2])
}
} else {
npcorr_update(npc, obs[1], obs[2])
}
v_gc[i]      <- grade_correlation(rho_now)
v_npc[i]     <- if (!is.null(npc)) npcorr_value(npc) else NA
v_herm[i]    <- tryCatch(spearmans(herm_stat), error = function(e) NA)
v_herm_ew[i] <- tryCatch(spearmans(herm_ew),   error = function(e) NA)
v_batch[i]   <- if (i >= 3) cor(all_x[1:i], all_y[1:i], method = "spearman") else NA
cat(paste(i, rho_now, v_gc[i], v_batch[i], v_npc[i], v_herm[i], v_herm_ew[i], sep = ","),
"\n", sep = "", file = csv, append = TRUE)
if (i %% report_every == 0) { draw(i); status(i) }
if (delay_ms > 0) Sys.sleep(delay_ms / 1000)
}
draw(N); status(N)
log_msg(sprintf("\nDone. %d observations written to %s\n", N, csv))
pdf_path <- sub("\\.csv$", ".pdf", csv)
pdf(pdf_path, width = 10, height = 6); draw(N); dev.off()
log_msg(sprintf("Plot saved to %s\n", pdf_path))
invisible(list(csv = csv, pdf = pdf_path))
}
simulate <- function(mode = c("stationary", "nonstationary"), ...) {
mode <- match.arg(mode)
if (mode == "stationary") run_stationary(...) else run_nonstationary(...)
}
if (!interactive() || length(commandArgs(trailingOnly = TRUE)) > 0) {
args <- commandArgs(trailingOnly = TRUE)
flag <- function(name, default) {
idx <- match(name, args)
if (is.na(idx)) return(default)
if (is.logical(default)) return(TRUE)
val <- args[idx + 1]
if (is.numeric(default)) return(as.numeric(val))
val
}
if (flag("--nonstationary", FALSE)) {
run_nonstationary(
N          = as.integer(flag("--N", 2000)),
delay_ms   = flag("--delay", 10),
report_every = as.integer(flag("--report", 20))
)
} else {
run_stationary(
N          = as.integer(flag("--N", 2000)),
rho        = flag("--rho", 0.6),
delay_ms   = flag("--delay", 10),
report_every = as.integer(flag("--report", 20))
)
}
}
simulate("stationary", N = 2000, rho = 0.6)
simulate("nonstationary", N = 2000, rho = 0.6)
simulate("nonstationary", N = 2000)
